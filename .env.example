# Copy this file to .env and set the URL for the HRMS API reachable by the device.
# Android emulators normally reach a local computer through 10.0.2.2, not localhost.
API_BASE_URL='http://192.168.29.254:91/api/'
# Required for face check-in. Obtain approved values from your backend/device administrator.
ATTENDANCE_DEVICE_NAME=
ATTENDANCE_SERIAL_NO=
ATTENDANCE_VERIFICATION_CODE=

